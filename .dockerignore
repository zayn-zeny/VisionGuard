# Docker ignore — keep build context small and secure
# Task 6.2: .dockerignore prevents secrets and large files from entering the image layer

# ── Secrets ──────────────────────────────────────────────────────────
.env
*.env
kaggle.json

# ── Virtual envs (use the image's pip install instead) ───────────────
venv/
.venv/
env/

# ── Data and models (large; only models/champion.keras is COPY'd) ────
data/
models/*.h5
models/*_best.keras
mlruns/
mlartifacts/
tuner_logs/
labs/
logs/
venv_install.log
.report_build/

# ── Dev / test tooling ───────────────────────────────────────────────
tests/
notebooks/
.pytest_cache/
.coverage
htmlcov/
*.log

# ── Version control ───────────────────────────────────────────────────
.git/
.gitignore
.dvc/
*.dvc

# ── Report source (not needed at runtime) ────────────────────────────
report/
Assignment\ 2.pdf

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

