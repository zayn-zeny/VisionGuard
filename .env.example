# ── Flask app ────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=change_me_in_production

# ── Inference mode: "local" or "remote" ──────────────────────────────
INFERENCE_MODE=local

# ── Model (local mode) ───────────────────────────────────────────────
MODEL_PATH=models/champion.keras
THRESHOLD=0.4

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://visionguard:changeme@db:5432/visionguard

# ── Remote API (remote mode) ──────────────────────────────────────────
REMOTE_API_URL=https://your-cloud-api-url/predict
REMOTE_API_KEY=your_remote_api_key_here

# ── MLflow / DagsHub ─────────────────────────────────────────────────
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/23L-0578_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# ── DVC remote (DagsHub S3-compatible) ───────────────────────────────
AWS_ACCESS_KEY_ID=your_dagshub_access_key
AWS_SECRET_ACCESS_KEY=your_dagshub_secret_key

# ── Kaggle ───────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Upload limits ─────────────────────────────────────────────────────
MAX_CONTENT_LENGTH_MB=10

# ── App metadata ──────────────────────────────────────────────────────
MODEL_NAME=MobileNetV2_VisionGuard
MODEL_VERSION=champion


# ── Task 7: Hugging Face Space deployment (scripts/deploy_hf_space.py) ──
HF_TOKEN=your_hf_write_token
HF_SPACE_ID=your_hf_username/23L-0578_A2_Ops
